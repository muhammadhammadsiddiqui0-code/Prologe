# ── Server-side only (set in your host's dashboard — never commit real values) ──

# Resend — https://resend.com  (verify the prologe.ae domain to send from connect@prologe.ae)
RESEND_API_KEY=
RESEND_FROM="Prologe <connect@prologe.ae>"
CONTACT_TO=connect@prologe.ae

# Supabase — run supabase/schema.sql first. Use the SERVICE ROLE key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional, client-side ──
# Only needed if the API lives on a different origin than the site.
# VITE_CONTACT_ENDPOINT=https://your-api.example.com/api/contact
